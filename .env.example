# Copie para .env e preencha. O .env nao e versionado.
# Token do bot criado no @BotFather.
TELEGRAM_BOT_TOKEN=
# chat_id do destino (usuario ou grupo). Veja no README como obter.
TELEGRAM_CHAT_ID=
# Opcional: chave da API do r.jina.ai (renderizador de fallback).
JINA_API_KEY=

# Opcional: Bearer da conta do clube Examine (destrava o jornal oficial).
EXAMINE_TOKEN=

# Opcional: configuracao por ambiente (qualquer chave do config.toml).
# O valor e lido como TOML; uma string sem aspas entra crua. CLI vence o ambiente.
# JORNALEIRO__AGENDA__HORARIOS=["07:00","19:00"]
# JORNALEIRO__RETENCAO__DIAS=15
# JORNALEIRO__RENDERER=jina

# Opcional: ritmo do healthcheck do Compose (JORNALEIRO__* e do processo, estas sao do Docker).
# JORNALEIRO_HEALTHCHECK_INTERVAL=2m
# JORNALEIRO_HEALTHCHECK_TIMEOUT=60s
# JORNALEIRO_HEALTHCHECK_RETRIES=2
# JORNALEIRO_HEALTHCHECK_START_PERIOD=3m
